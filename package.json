{
  "name": "journal-kpp",
  "version": "1.0.0",
  "description": "Журнал КПП",
  "author": "Igor",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron:build": "electron-builder --win portable"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "chart.js": "^4.5.1",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "nanoid": "^6.0.2",
    "nuxt": "4.5.2",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@markuplint/vue-parser": "^5.0.1",
    "@markuplint/vue-spec": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.1.0",
    "@vue/language-plugin-pug": "^3.3.12",
    "daisyui": "^5.7.47",
    "electron": "^44.6.0",
    "electron-builder": "^26.17.0",
    "knip": "^6.40.0",
    "markuplint": "^5.0.1",
    "pug": "^3.0.4",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.12"
  },
  "build": {
    "appId": "com.journalkpp.app",
    "productName": "Журнал КПП",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      ".output/public/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "JournalKPP.exe"
    },
    "npmRebuild": false
  }
