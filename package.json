{
  "name": "journal-kpp",
  "version": "1.0.5",
  "description": "Журнал КПП",
  "author": "Igor",
  "main": "main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:lan": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:build": "electron-builder --win portable"
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "chart.js": "4.6.1",
    "fuse.js": "^7.5.0",
    "gsap": "3.15.1",
    "nanoid": "^6.0.2",
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@markuplint/vue-parser": "5.4.0",
    "@markuplint/vue-spec": "5.4.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vue/language-plugin-pug": "3.3.14",
    "daisyui": "5.7.50",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "happy-dom": "21.0.4",
    "knip": "6.44.2",
    "markuplint": "5.4.0",
    "pug": "^3.0.4",
    "sass": "1.108.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.journalkpp.app",
    "productName": "Журнал КПП",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.cjs",
      ".output/public/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "JournalKPP.exe"
    },
    "npmRebuild": false
  }
}
