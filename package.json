{
  "name": "journal-kpp",
  "version": "1.0.0",
  "description": "Журнал КПП",
  "author": "Igor",
  "main": "main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:build": "electron-builder --win portable"
  },
  "dependencies": {
    "@lucide/vue": "1.62.0",
    "chart.js": "4.6.1",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "nanoid": "^6.0.2",
    "nuxt": "4.6.3",
    "vue": "3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@markuplint/vue-parser": "5.3.0",
    "@markuplint/vue-spec": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@vue/language-plugin-pug": "3.3.13",
    "daisyui": "5.7.50",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "happy-dom": "21.0.4",
    "knip": "6.43.0",
    "markuplint": "5.3.0",
    "pug": "^3.0.4",
    "sass": "1.106.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.journalkpp.app",
    "productName": "Журнал КПП",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.cjs",
      ".output/public/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "JournalKPP.exe"
    },
    "npmRebuild": false
  }
}
