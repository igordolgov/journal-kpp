+    const pDirect = walked(direct, 20)
+    const pCurved = walked(curved, 20)
+    // на 20px хода «напрямую» человек ещё дальше от оси, чем при 100%
+    expect(Math.abs(pDirect.x - AXIS_X)).toBeGreaterThan(Math.abs(pCurved.x - AXIS_X))
