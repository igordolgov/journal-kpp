{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "app/pages/**/*.vue",
        "app/layouts/**/*.vue",
        "app/middleware/**/*.{ts,js}",
        "app/plugins/**/*.{ts,js}",
        "app/components/**/*.vue",
        "app/composables/**/*.{ts,js}",
        "server/**/*.{ts,js}"
      ],
      "project": ["app/**/*.{js,ts,vue,css}"],
      "ignoreDependencies": [
        "@markuplint/pug-parser",
        "@markuplint/vue-parser",
        "@markuplint/vue-spec",
        "@iconify-json/heroicons",
        "@iconify-json/mdi",
        "pug"
      ]
    }
  }
}
