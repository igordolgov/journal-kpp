+<style scoped>
+.simulator-dock { outline: none; background-color: rgb(17 24 39); }
+.slide-up-enter-active, .slide-up-leave-active { transition: all 0.3s ease; }
+.slide-up-enter-from, .slide-up-leave-to { transform: translateY(100%); }
